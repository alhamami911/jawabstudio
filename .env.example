# ============================================================
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# ============================================================

# --- Jawab ERP target (staging/demo ONLY; the host must be listed in config/production.json allowedHosts) ---
JAWAB_BASE_URL=https://staging.example.com
JAWAB_USER=
JAWAB_PASSWORD=

# --- Voice (ElevenLabs). Use a key limited to Text-to-Speech ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Production dashboard (npm run dashboard) ---
# Binds to 127.0.0.1 by default. Use 0.0.0.0 only on a trusted network and set a share password.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=4173
# DASHBOARD_SHARE_PASSWORD=
ADMIN_USER=
ADMIN_PASSWORD=

# --- Delivery / publishing (optional) ---
# JAWAB_DRIVE_DIR=       # local Google Drive folder for finished videos
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# --- Studio database used by seed/probe scripts (optional, dev only) ---
# JAWAB_STUDIO_URL=
# JAWAB_STUDIO_USER=
# JAWAB_STUDIO_PASSWORD=

# --- Local voice cloning experiment (docs/AUDAR-TTS-HANDOFF.md) ---
# HF_TOKEN=
